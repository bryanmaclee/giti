// giti — live status (channel dogfood, §38)
//
// First runtime-tier exercise of the <channel> surface in giti. A
// <channel>-declared <snapshot> cell auto-syncs across every connected client
// (§38.4): refreshStatus() reads real `jj` working-copy status via giti's
// engine and writes the cell; the write lowers to a __sync broadcast so every
// open tab updates live. No polling — one client clicking "Refresh" updates all.
//
// Idiom note (S15): the request lifecycle is a typed Phase enum field
// (Idle | Ok | Error) rendered with <match for=Phase>, replacing the old
// raw-string-in-DOM `state: "idle"/"ok"/"error"` flag. It is a <match>, NOT a
// Tier-2 <engine>: an engine OWNS its cell's variant progression and the
// engine cell cannot also be a server-written <channel>-synced cell (E-RI-002
// — server fns may write a channel cell, but NOT an engine cell). So the live
// page keeps its channel cell and matches on a typed state field. The
// engine-cannot-drive-a-channel-cell gap is to be reported to scrml. The
// changed-files list is now <each>.

<program>

type Phase:enum = {
  Idle
  Ok
  Error
}

<channel name="repo-status" topic="working-copy">
  ${
    // Server-only imports — preserved in .server.js, pruned from .client.js.
    import { getEngine } from '../src/engine/index.js'
    import { parseStatus } from '../src/lib/parse-status.js'

    // V5-strict auto-synced cell (§38.4 — no @shared modifier). The state
    // field is a typed Phase enum, not a string flag.
    <snapshot> = {
      state: Phase.Idle,
      bookmark: not,
      changed: [],
      conflicts: [],
      error: not,
      at: not,
    }

    // Single-top-level-write + no-reassignment style retained from the original.
    // It began as the GITI-020 / GITI-021 workarounds (channel-cell-write and
    // server-fn local-reassignment mis-lowering), which the master-list records
    // CLOSED at 8e7f18fe (S12, pre scrmlTS→scrml migration). The style is harmless
    // either way and kept for stability; not re-verified on the migrated compiler.
    //   - @snapshot is written exactly once at the top level of the function.
    //   - every local is a single-assignment `const`; branches are ternaries.
    server function refreshStatus() {
      const engine = getEngine()
      const res = await engine.status()
      const parsed = res.ok
        ? parseStatus(res.data.raw || "")
        : { bookmark: not, changed: [], conflicts: [] }
      @snapshot = {
        state: res.ok ? Phase.Ok : Phase.Error,
        bookmark: parsed.bookmark,
        changed: parsed.changed,
        conflicts: parsed.conflicts,
        error: res.ok ? not : res.error,
        at: new Date().toISOString(),
      }
    }
  }
</>

${
  function refresh() {
    refreshStatus()
  }
}

<header class="topbar">
  <div class="title">
    <span class="logo">giti</>
    <span class="muted">live</>
  </>
  <nav>
    <a href="/">Status</>
    <a href="/history.html">History</>
    <a href="/bookmarks.html">Bookmarks</>
    <a href="/diff.html">Diff</>
    <a href="/land.html">Land</>
    <a href="/live.html" class="active">Live</>
  </>
</header>

<div class="app">
  <h1>giti — live status</>
  <p class="meta">Channel: <code>repo-status</code> · updates broadcast to every open tab</>

  <div class="card">
    <p>State:
      <match for=Phase on=@snapshot.state>
        <Idle><strong class="muted">idle</strong></Idle>
        <Ok><strong class="ok">ok</strong></Ok>
        <Error><strong class="err">error</strong></Error>
      </match>
    </p>
    <p>Bookmark: ${@snapshot.bookmark}</>
    <p>Changed files: ${@snapshot.changed.length}</>
    <p>Conflicts: ${@snapshot.conflicts.length}</>
    <p class="ts">Last update: ${@snapshot.at}</>
    <button onclick=refresh()>Refresh now</>
  </>

  <ul class="files">
    <each in=@snapshot.changed>
      <li><span class="kind">${@.kind}</span> ${@.path}</li>
      <empty><li class="muted">No changed files.</li></empty>
    </each>
  </ul>
</div>

#{
  @import url('theme.css');

  .app { max-width: 760px; margin: 0 auto; padding: 24px; }
  .card { border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin: 16px 0; }
  .meta { color: var(--muted); }
  .ts { color: var(--muted); font-size: 12px; }
  .ok { color: var(--ok); }
  .err { color: var(--err); }
  .files { list-style: none; padding: 0; }
  .files li { font-family: var(--mono); padding: 2px 0; }
  .kind { color: var(--accent); }
  button { margin-top: 8px; }
}

</program>
