// giti — live status feed (SSE dogfood, §37)
//
// Runtime-tier exercise of the `server function*` SSE surface. A
// `server function*` polls giti's engine on an interval and `yield`s a status
// snapshot as a named SSE event. The compiler emits a text/event-stream GET
// route + an EventSource client stub; binding the call to an @reactive cell
// updates the page on every event.
//
// Idiom note (S15): the request lifecycle is a typed Phase enum field
// (Idle | Ok | Error) rendered with <match for=Phase>, replacing the old
// raw-string-in-DOM `state: "ok"/"error"` flag. As on live.scrml it is a
// <match>, NOT a Tier-2 <engine>: the @status cell is bound to the SSE
// generator, and an engine OWNS its cell's progression — it can't be a
// stream-/server-driven cell (E-RI-002 class). Same gap as live.scrml.
//
// SSE runtime status is CONTESTED and NOT re-verified this session:
//   - giti's master-list records GITI-025 + GITI-026 (parameterized + dead SSE
//     binding) BOTH FIXED at e2dcde7b (S12, 2026-05-30) with feed working
//     client-side — but that was on scrmlTS v0.7.0, BEFORE the scrml migration.
//   - the 2026-06-20 idiomatic audit reported the SSE binding still dead (CG-4).
// This rewrite lands the idiomatic SHAPE either way (it compiles + serves 200);
// whether events reach @status on the migrated compiler is unverified — a quick
// SSE runtime probe is the follow-up. (Kept the generator parameter-less: it
// reads the current repo from server state, so it needs none — independent of
// the GITI-025 param-binding fix.)

<program>

type Phase:enum = {
  Idle
  Ok
  Error
}

${
  import { getEngine } from '../src/engine/index.js'
  import { parseStatus } from '../src/lib/parse-status.js'
  import { delay } from '../src/lib/delay.js'

  server function* watchStatus() {
    while (true) {
      const res = await getEngine().status()
      const parsed = res.ok
        ? parseStatus(res.data.raw || "")
        : { bookmark: not, changed: [], conflicts: [] }
      yield {
        event: "status",
        data: {
          state: res.ok ? Phase.Ok : Phase.Error,
          changed: parsed.changed.length,
          conflicts: parsed.conflicts.length,
          bookmark: parsed.bookmark,
          error: res.ok ? not : res.error,
          at: new Date().toISOString(),
        },
      }
      await delay(1000)
    }
  }
}

// Seeded at .Idle so the first paint (before any SSE event) is type-sound;
// the SSE binding is a module-top write (wrapped in ${} — a write, not a
// declaration; on-mount placement trips an SSE-binding codegen bug, S15).
<status> = { state: Phase.Idle, changed: 0, conflicts: 0, bookmark: not, error: not, at: not }
${ @status = watchStatus() }

<div class="app">
  <h1>giti — live status feed</>
  <p class="meta">Source: <code>server function* watchStatus</code> · streamed over SSE</>

  <div class="card">
    <p>State:
      <match for=Phase on=@status.state>
        <Idle><strong class="muted">waiting…</strong></Idle>
        <Ok><strong class="ok">ok</strong></Ok>
        <Error><strong class="err">error</strong></Error>
      </match>
    </p>
    <p>Changed files: ${@status.changed}</>
    <p>Conflicts: ${@status.conflicts}</>
    <p>Bookmark: ${@status.bookmark}</>
    <p class="ts">As of: ${@status.at}</>
  </>
</div>

#{
  @import url('theme.css');
  .app { max-width: 720px; margin: 0 auto; padding: 24px; }
  .card { border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin: 16px 0; }
  .meta { color: var(--muted); }
  .ts { color: var(--muted); font-size: 12px; }
  .ok { color: var(--ok); }
  .err { color: var(--err); }
}

</program>
