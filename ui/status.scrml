// giti — status dashboard (iteration 4)
//
// Three independent async loads — current status, bookmarks, recent saves —
// each modeled as its own RemoteData-style enum (Loading/Loaded/Failed) and
// rendered with <match for=Phase>. The .Loading initial variant is the seed
// state, which retires the old hydrate-with-defaults GITI-006 dodge: there is
// no bare `${@x.y}` module-top read anymore, the cell simply starts .Loading.
//
// Data source: giti's JS engine module (jj-cli wrapper) called from
// server-function bodies, which return a Phase variant straight off the
// engine Result tuple. The compiler keeps the import in .server.js
// (GITI-002) and prunes it from .client.js (GITI-003).

<program>

// GITI-009 fixed upstream: scrml rewrites relative-import paths for the
// compiled output location, so source-relative paths are correct.
import { getEngine } from '../src/engine/index.js'
import { safeCallAsync } from "scrml:host"
import { parseStatus } from '../src/commands/status.js'
import { classifyFromStatus } from '../src/private/save-routing.js'

// ---------- Types: one Phase enum per independent load ----------

type FileChange:struct = { kind: string, path: string }
type StatusData:struct = {
  scope: string
  bookmark: string?
  conflicts: string[]
  publicFiles: FileChange[]
  privateFiles: FileChange[]
}
type StatusPhase:enum = {
  Loading
  Loaded(data: StatusData)
  Failed(err: string)
}

type Bookmark:struct = { name: string, info: string }
type BookmarksPhase:enum = {
  Loading
  Loaded(list: Bookmark[])
  Failed(err: string)
}

type Entry:struct = { changeId: string, description: string, author: string, timestamp: string }
type HistoryPhase:enum = {
  Loading
  Loaded(entries: Entry[])
  Failed(err: string)
}

// ---------- Server functions: wrap the engine, return a Phase variant ----------

server function loadStatus() {
  const engine = getEngine()
  const res = safeCallAsync(() => engine.status()) !{
    | ::Thrown(msg) :> ({ ok: false, error: msg })
  }
  if (!res.ok) return StatusPhase.Failed(res.error)
  const cls = classifyFromStatus(res.data.raw || "", process.cwd())
  return StatusPhase.Loaded({
    scope: cls.scope,
    bookmark: cls.parsed.bookmark,
    conflicts: cls.parsed.conflicts,
    publicFiles: cls.publicFiles,
    privateFiles: cls.privateFiles,
  })
}

server function loadHistory() {
  const engine = getEngine()
  const res = safeCallAsync(() => engine.history(12)) !{
    | ::Thrown(msg) :> ({ ok: false, error: msg })
  }
  if (!res.ok) return HistoryPhase.Failed(res.error)
  return HistoryPhase.Loaded(res.data)
}

server function loadBookmarks() {
  const engine = getEngine()
  const res = safeCallAsync(() => engine.listBranches()) !{
    | ::Thrown(msg) :> ({ ok: false, error: msg })
  }
  if (!res.ok) return BookmarksPhase.Failed(res.error)
  return BookmarksPhase.Loaded(res.data)
}

// ---------- Reactive state: each load seeded at .Loading ----------
// Per §13.5.5 the three independent server calls are parallelized on mount.

<status>    = StatusPhase.Loading
<bookmarks> = BookmarksPhase.Loading
<history>   = HistoryPhase.Loading

// Three separate mount blocks (§6.7.1a) — independent loads the compiler
// parallelizes (§13.3/§13.5.5); each transitions its own Phase cell.
on mount { @status    = loadStatus() }
on mount { @bookmarks = loadBookmarks() }
on mount { @history   = loadHistory() }

<div class="app">

  <header class="topbar">
    <div class="title">
      <span class="logo">giti</span>
      <span class="muted">status</span>
    </div>
    <nav>
      <a href="/" class="active">Status</a>
      <a href="/history.html">History</a>
      <a href="/bookmarks.html">Bookmarks</a>
      <a href="/diff.html">Diff</a>
      <a href="/land.html">Land</a>
      <a href="/live.html">Live</a>
    </nav>
  </header>

  <main>

    <!-- ============ CURRENT STATUS ============ -->
    <section class="panel">
      <h2>Current status</h2>

      <match for=StatusPhase on=@status>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Engine error: ${err}</p></Failed>
        <Loaded(d)>
          ${ d.scope == "empty" && d.conflicts.length == 0 ? <p class="muted">Working copy is clean. No pending changes.</p> : "" }

          ${ d.bookmark ? <p class="kv"><span class="k">On</span> <span class="mono">${d.bookmark}</span></p> : "" }

          ${ d.conflicts.length > 0 ? <div class="conflicts">
              <h3>Conflicts</h3>
              <ul class="file-list">
                <each in=d.conflicts>
                  <li class="conflict"><span class="tag tag-conflict">conflict</span> ${@.}</li>
                </each>
              </ul>
              <p class="hint">Resolve these files, then <code>giti save</code>.</p>
            </div> : "" }

          ${ d.publicFiles.length > 0 ? <div class="changes">
              <h3>Public changes <span class="count">${d.publicFiles.length}</span></h3>
              <ul class="file-list">
                <each in=d.publicFiles key=@.path>
                  <li>
                    <span class="tag tag-${@.kind}">${@.kind}</span>
                    <span class="path">${@.path}</span>
                  </li>
                </each>
              </ul>
            </div> : "" }

          ${ d.privateFiles.length > 0 ? <div class="changes private">
              <h3>Private changes <span class="count">${d.privateFiles.length}</span></h3>
              <ul class="file-list">
                <each in=d.privateFiles key=@.path>
                  <li>
                    <span class="tag tag-${@.kind}">${@.kind}</span>
                    <span class="path">${@.path}</span>
                    <span class="scope-mark">private</span>
                  </li>
                </each>
              </ul>
            </div> : "" }

          ${ d.scope == "mixed" ? <div class="hint-box">
              <strong>Mixed save.</strong>
              <span class="muted">Use</span>
              <code>giti save --split "msg"</code>
              <span class="muted">to split into a public and a private commit.</span>
            </div> : "" }
        </Loaded>
      </match>

    </section>

    <!-- ============ BOOKMARKS ============ -->
    <section class="panel">
      <h2>Bookmarks</h2>
      <match for=BookmarksPhase on=@bookmarks>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not list bookmarks: ${err}</p></Failed>
        <Loaded(list)>
          <ul class="bookmark-list">
            <each in=list key=@.name>
              <li class="bookmark">
                <span class="name ${@.name == "_private" ? "name-priv" : "name-pub"}">${@.name}</span>
                <span class="info muted">${@.info}</span>
              </li>
              <empty><p class="muted">No bookmarks yet.</p></empty>
            </each>
          </ul>
        </Loaded>
      </match>
      <p class="hint">
        <code>main</code> tracks public commits.
        <code>_private</code> tracks your personal overlay — never leaves machines scoped 'private'.
      </p>
    </section>

    <!-- ============ HISTORY ============ -->
    <section class="panel">
      <h2>Recent saves</h2>
      <match for=HistoryPhase on=@history>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not read history: ${err}</p></Failed>
        <Loaded(entries)>
          <ol class="history-list">
            <each in=entries key=@.changeId>
              <li class="entry">
                <span class="change-id">${@.changeId}</span>
                <span class="desc">${@.description || "(no message)"}</span>
                <span class="author muted">${@.author}</span>
                <span class="time muted">${@.timestamp}</span>
              </li>
              <empty><p class="muted">No saves yet. Try <code>giti save "first"</code>.</p></empty>
            </each>
          </ol>
        </Loaded>
      </match>
    </section>

  </main>

  <footer class="bottombar">
    <span class="muted">giti 0.1.0</span>
    <span class="muted">·</span>
    <span class="muted">local-dev</span>
    <span class="muted">·</span>
    <span class="muted">spec §12 private scopes</span>
  </footer>

</div>

#{
  @import url('theme.css');

  /* Shared chrome + tokens live in theme.css (imported above).
     Only status-specific rules below. */

  .kv { display: flex; align-items: baseline; gap: 0.5rem; margin: 0.25rem 0; }
  .kv .k { color: var(--muted); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; }

  .hint {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .hint-box {
    margin-top: 0.8rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--warn);
    border-radius: 6px;
    background: rgba(210, 153, 34, 0.06);
    font-size: 0.88rem;
  }

  .hint-box strong { color: var(--warn); }

  /* ----- file lists ----- */

  .file-list,
  .history-list,
  .bookmark-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .file-list li,
  .bookmark-list li {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .file-list li:last-child,
  .bookmark-list li:last-child {
    border-bottom: none;
  }

  .path {
    font-family: var(--mono);
    color: var(--fg);
    flex: 1;
  }

  .scope-mark {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--priv);
  }

  .changes.private {
    margin-top: 0.75rem;
  }

  .conflicts {
    border: 1px solid var(--err);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    margin: 0.5rem 0;
    background: rgba(248, 81, 73, 0.06);
  }

  .conflicts h3 { color: var(--err); margin-top: 0; }

  /* ----- tags (kind badges) ----- */

  .tag {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: var(--border);
    color: var(--muted);
    font-weight: 500;
    min-width: 4.5rem;
    text-align: center;
  }

  .tag-modified { color: var(--warn); }
  .tag-added    { color: var(--ok); }
  .tag-deleted  { color: var(--err); }
  .tag-conflict { color: var(--err); background: rgba(248, 81, 73, 0.1); }

  /* ----- bookmarks ----- */

  .bookmark .name {
    font-family: var(--mono);
    font-weight: 600;
  }

  .name-pub  { color: var(--accent); }
  .name-priv { color: var(--priv); }

  .bookmark .info {
    flex: 1;
    font-size: 0.82rem;
  }

  /* ----- history ----- */

  .history-list {
    counter-reset: entry;
  }

  .history-list .entry {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.88rem;
  }

  .history-list .entry:last-child { border-bottom: none; }

  .change-id {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .desc {
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author, .time {
    font-size: 0.78rem;
  }
}

</program>
