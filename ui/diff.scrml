// giti — diff viewer (v2)
//
// v0 showed the raw working-copy diff. v1 added per-change selection via
// URL query (/diff.html?change=<id>). v2 models the two axes as enums:
//   - DiffMode  (WorkingCopy | Change(id))  — which diff we're viewing,
//     derived synchronously from the ?change= URL param. The id rides as a
//     variant payload, so there's no `change: string?` truthy-checking.
//   - DiffPhase (Loading | Loaded(diff) | Failed) — the async load lifecycle.
// Left pane: recent history (its own HistoryPhase). Right pane: the diff.
//
// Selection flow: each history entry is an <a href="/diff.html?change=X">.
// Clicking navigates — the client reads route's ?change= and passes it to the
// server fn. Full-page reload, no client-side state. Tests scrml's SPEC §20.3
// route.query injection from the author side.

<program>

// GITI-009 fixed upstream: scrml rewrites relative-import paths for dist/ui/.
import { getEngine } from '../src/engine/index.js'

type DiffMode:enum = {
  WorkingCopy
  Change(id: string)
}
type DiffPhase:enum = {
  Loading
  Loaded(diff: string)
  Failed(err: string)
}
type Entry:struct = { changeId: string, description: string, author: string, timestamp: string }
type HistoryPhase:enum = {
  Loading
  Loaded(entries: Entry[])
  Failed(err: string)
}

// The ?change= URL param is a client-only read (window.location). Two pure
// derivations off it: the view mode, and the raw id to hand the server fn.
fn modeFromUrl() {
  const param = new URLSearchParams(window.location.search).get('change')
  return param is some ? DiffMode.Change(param) : DiffMode.WorkingCopy
}
fn changeIdFromUrl() {
  return new URLSearchParams(window.location.search).get('change')
}

server function loadHistory() {
  const engine = getEngine()
  const res = await engine.history(30)
  if (!res.ok) return HistoryPhase.Failed(res.error)
  return HistoryPhase.Loaded(res.data)
}

// changeId: string | not. not → working-copy diff; otherwise → that change.
// The compiler's internal route.query is NOT author-exposed (E-SCOPE-001),
// so the client reads the URL param and passes it in as an explicit arg.
server function loadDiff(changeId) {
  const engine = getEngine()
  const res = changeId
    ? await engine.diffChange(changeId)
    : await engine.diff()
  if (!res.ok) return DiffPhase.Failed(res.error)
  return DiffPhase.Loaded(res.data || "")
}

<mode>:    DiffMode    = DiffMode.WorkingCopy
<history>: HistoryPhase = HistoryPhase.Loading
<diff>:    DiffPhase   = DiffPhase.Loading

on mount { @mode    = modeFromUrl() }
on mount { @history = loadHistory() }
on mount { @diff    = loadDiff(changeIdFromUrl()) }

<div class="app">

  <header class="topbar">
    <div class="title">
      <span class="logo">giti</span>
      <span class="muted">diff</span>
    </div>
    <nav>
      <a href="/">Status</a>
      <a href="/history.html">History</a>
      <a href="/bookmarks.html">Bookmarks</a>
      <a href="/diff.html" class="active">Diff</a>
      <a href="/land.html">Land</a>
      <a href="/live.html">Live</a>
    </nav>
  </header>

  <main class="diff-layout">

    <aside class="panel change-picker">
      <h2>Changes</h2>
      <p class="muted">
        <match for=DiffMode on=@mode>
          <WorkingCopy><span>Pending changes (selected)</span></WorkingCopy>
          <Change(id)><a href="/diff.html">← Pending changes</a></Change>
        </match>
      </p>
      <match for=HistoryPhase on=@history>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not read history: ${err}</p></Failed>
        <Loaded(entries)>
          <ol class="picker-list">
            <each in=entries key=@.changeId>
              <li>
                <a href="/diff.html?change=${@.changeId}">
                  <code class="change-id">${@.changeId}</code>
                  <span class="desc">${@.description || "(no message)"}</span>
                </a>
              </li>
              <empty><p class="muted">No saves yet.</p></empty>
            </each>
          </ol>
        </Loaded>
      </match>
    </aside>

    <section class="panel diff-view">
      <h2>
        <match for=DiffMode on=@mode>
          <WorkingCopy><span>Pending changes</span></WorkingCopy>
          <Change(id)><span>Diff for <code>${id}</code></span></Change>
        </match>
      </h2>

      <match for=DiffPhase on=@diff>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not read diff: ${err}</p></Failed>
        <Loaded(diffText)>
          ${ diffText == "" ? <p class="muted">
              <match for=DiffMode on=@mode>
                <WorkingCopy><span>No pending changes. Working copy is clean.</span></WorkingCopy>
                <Change(id)><span>This change introduced no file modifications.</span></Change>
              </match>
            </p> : <pre class="diff-pane">${diffText}</pre> }
        </Loaded>
      </match>
    </section>

  </main>

  <footer class="bottombar">
    <span class="muted">giti 0.1.0</span>
    <span class="muted">·</span>
    <span class="muted">local-dev</span>
  </footer>

</div>

#{
  @import url('theme.css');

  /* Shared chrome lives in theme.css. Only page-specific rules below. */

  .diff-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 16px;
    align-items: start;
  }

  .change-picker {
    position: sticky;
    top: 16px;
  }

  .change-picker h2 {
    margin-bottom: 8px;
  }

  .picker-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .picker-list li {
    border-bottom: 1px solid var(--border);
  }

  .picker-list li:last-child {
    border-bottom: none;
  }

  .picker-list a {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 8px;
    padding: 8px 4px;
    color: var(--fg);
    text-decoration: none;
    align-items: baseline;
  }

  .picker-list a:hover {
    background: rgba(88, 166, 255, 0.06);
  }

  .change-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: var(--accent);
  }

  .desc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
  }

  .diff-view h2 code {
    background: var(--bg);
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 6px;
    font-size: 13px;
  }

  .diff-pane {
    margin: 0;
    padding: 12px 16px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    line-height: 1.45;
    white-space: pre;
    overflow-x: auto;
    color: var(--fg);
  }
}

</program>
