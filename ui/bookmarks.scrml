// giti — bookmarks
//
// Lists every named bookmark known to the engine, including remote-tracking
// branches (jj `bookmark list --all-remotes`). Same shell + theme as
// status.scrml and history.scrml.

<program>

// GITI-009 fixed upstream: scrml rewrites relative-import paths for dist/ui/.
import { getEngine } from '../src/engine/index.js'

type Bookmark:struct = { name: string, info: string, active: boolean }
type BookmarksPhase:enum = {
  Loading
  Loaded(list: Bookmark[])
  Failed(err: string)
}

// Distinct fn name from status.scrml's loadBookmarks to avoid any per-file
// route ambiguity in composeScrmlFetch. Returns a BookmarksPhase variant
// straight off the engine Result tuple.
server function loadBookmarkList() {
  const engine = getEngine()
  const res = await engine.listBranches()
  if (!res.ok) return BookmarksPhase.Failed(res.error)
  return BookmarksPhase.Loaded(res.data)
}

<bookmarks> = BookmarksPhase.Loading
on mount { @bookmarks = loadBookmarkList() }

<div class="app">

  <header class="topbar">
    <div class="title">
      <span class="logo">giti</span>
      <span class="muted">bookmarks</span>
    </div>
    <nav>
      <a href="/">Status</a>
      <a href="/history.html">History</a>
      <a href="/bookmarks.html" class="active">Bookmarks</a>
      <a href="/diff.html">Diff</a>
      <a href="/land.html">Land</a>
      <a href="/live.html">Live</a>
    </nav>
  </header>

  <main>

    <section class="panel">
      <h2>Bookmarks</h2>
      <p class="muted">All named bookmarks, including remote-tracking branches. Run <code>giti switch &lt;name&gt;</code> in the terminal to switch.</p>

      <match for=BookmarksPhase on=@bookmarks>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not list bookmarks: ${err}</p></Failed>
        <Loaded(list)>
          <ul class="bookmark-list">
            <each in=list key=@.name>
              <li class="bookmark">
                <code class="name">${@.name}</code>
                <span class="info muted">${@.info}</span>
                ${ @.active ? <span class="badge active">active</span> : "" }
              </li>
              <empty><p class="muted">No bookmarks yet. Try <code>giti save</code> to create your first.</p></empty>
            </each>
          </ul>
        </Loaded>
      </match>
    </section>

  </main>

  <footer class="bottombar">
    <span class="muted">giti 0.1.0</span>
    <span class="muted">·</span>
    <span class="muted">local-dev</span>
  </footer>

</div>

#{
  @import url('theme.css');

  /* Shared chrome lives in theme.css. Only page-specific rules below. */

  .name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--accent);
  }

  .bookmark-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bookmark-list .bookmark {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .bookmark-list .bookmark:last-child {
    border-bottom: none;
  }

  .info {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
  }

  .badge {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 12px;
    background: var(--border);
    color: var(--fg);
  }

  .badge.active {
    background: var(--ok);
    color: var(--bg);
    font-weight: 600;
  }
}

</program>
