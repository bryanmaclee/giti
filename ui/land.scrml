// giti — landing preflight dashboard
//
// Read-only "would `giti land` succeed right now?" view. Runs the same four
// gates `giti land` runs, in order, on page load:
//   1. Private-files gate  — landings must be public (spec §12.3)
//   2. Conflicts gate      — refuse if working copy has conflicts
//   3. Compiler gate       — all .scrml files must compile
//   4. Tests gate          — `bun test` must be green
//
// The actual landing (save + merge to main) is a write op and is NOT
// performed here. This page is the pre-flight; the user runs `giti land`
// from the CLI when ready (and we may add a "Land" button in a later
// slice once auth + dest gating exist).
//
// The preflight lifecycle is a PreflightPhase enum (Loading/Loaded/Failed)
// rendered via <match> — the .Loading variant replaces the old `running:true`
// boolean + the GITI-006 hydrate-with-defaults dodge.

<program>

// Source-relative paths (GITI-009 fixed upstream).
import { getEngine } from '../src/engine/index.js'
import { parseStatus } from '../src/commands/status.js'
import { runCompiler, runTests } from '../src/commands/land.js'
import { loadPrivateManifest, partitionByScope } from '../src/private/scope.js'

// ---------- Types: the preflight report + its lifecycle phase ----------

type GateFile:struct = { path: string, kind: string }
type PrivateGate:struct = { ok: boolean, files: GateFile[] }
type ConflictsGate:struct = { ok: boolean, files: string[], error: string? }
type CompilerGate:struct = { ok: boolean, fileCount: number?, skipped: boolean?, error: string? }
type TestsGate:struct = { ok: boolean, count: string?, error: string? }
type PreflightReport:struct = {
  allOk: boolean
  privateGate: PrivateGate
  conflictsGate: ConflictsGate
  compilerGate: CompilerGate
  testsGate: TestsGate
}
type PreflightPhase:enum = {
  Loading
  Loaded(report: PreflightReport)
  Failed(err: string)
}

server function loadLandingPreflight() {
  const engine = getEngine()

  // Gate 1: private-files
  const statusRes = await engine.status()
  let privateGate = { ok: true, files: [] }
  if (statusRes.ok && statusRes.data.raw) {
    const parsed = parseStatus(statusRes.data.raw)
    const globs = loadPrivateManifest(process.cwd())
    const part = partitionByScope(parsed.changed, globs)
    const privChanged = part.private
    privateGate = {
      ok: !privChanged.length,
      files: privChanged.map(f => ({ path: f.path, kind: f.kind })),
    }
  }

  // Gate 2: conflicts
  const conflictRes = await engine.conflicts()
  const conflictsGate = conflictRes.ok
    ? { ok: !conflictRes.data.hasConflicts, files: conflictRes.data.files || [] }
    : { ok: false, error: conflictRes.error, files: [] }

  // Gate 3: compiler (all .scrml files)
  const compilerRes = await runCompiler()
  const compilerGate = compilerRes.ok
    ? {
        ok: true,
        fileCount: compilerRes.data.fileCount || 0,
        skipped: !!compilerRes.data.skipped,
      }
    : { ok: false, error: compilerRes.error }

  // Gate 4: tests (full bun test)
  const testRes = await runTests()
  const testsGate = testRes.ok
    ? { ok: true, count: testRes.data.count }
    : { ok: false, error: testRes.error }

  const allOk =
    privateGate.ok && conflictsGate.ok && compilerGate.ok && testsGate.ok

  return PreflightPhase.Loaded({
    allOk,
    privateGate,
    conflictsGate,
    compilerGate,
    testsGate,
  })
}

<preflight> = PreflightPhase.Loading
on mount { @preflight = loadLandingPreflight() }

<div class="app">

  <header class="topbar">
    <div class="title">
      <span class="logo">giti</span>
      <span class="muted">land</span>
    </div>
    <nav>
      <a href="/">Status</a>
      <a href="/history.html">History</a>
      <a href="/bookmarks.html">Bookmarks</a>
      <a href="/diff.html">Diff</a>
      <a href="/land.html" class="active">Land</a>
      <a href="/live.html">Live</a>
    </nav>
  </header>

  <main>
    <section class="panel">
      <h2>Landing preflight</h2>
      <p class="muted">
        Same gates <code>giti land</code> runs. This view is read-only —
        nothing is landed from the dashboard.
      </p>

      <match for=PreflightPhase on=@preflight>
        <Loading><p class="muted">Running gates… (compile + tests can take a few seconds)</p></Loading>
        <Failed(err)><p class="error">Engine error: ${err}</p></Failed>
        <Loaded(r)>
          ${ r.allOk
            ? <p class="banner banner-ok">All gates pass — your work would land cleanly.</p>
            : <p class="banner banner-fail">One or more gates failed — see details below.</p> }

          <ul class="gates">

            <!-- Gate 1: private files -->
            <li class="gate">
              <span class="gate-name">Private files</span>
              ${ r.privateGate.ok
                ? <span class="badge badge-ok">pass</span>
                : <span class="badge badge-fail">fail</span> }
              ${ r.privateGate.files.length > 0 ? <ul class="gate-detail">
                  <each in=r.privateGate.files key=@.path>
                    <li><span class="tag tag-${@.kind}">${@.kind}</span> <span class="mono">${@.path}</span></li>
                  </each>
                </ul> : "" }
            </li>

            <!-- Gate 2: conflicts -->
            <li class="gate">
              <span class="gate-name">Conflicts</span>
              ${ r.conflictsGate.ok
                ? <span class="badge badge-ok">pass</span>
                : <span class="badge badge-fail">fail</span> }
              ${ r.conflictsGate.files.length > 0 ? <ul class="gate-detail">
                  <each in=r.conflictsGate.files>
                    <li><span class="mono">${@.}</span></li>
                  </each>
                </ul> : "" }
            </li>

            <!-- Gate 3: compiler -->
            <li class="gate">
              <span class="gate-name">Compiler</span>
              ${ r.compilerGate.ok && r.compilerGate.skipped
                ? <span class="badge badge-skip">skipped — no .scrml files</span>
                : r.compilerGate.ok
                  ? <span class="badge badge-ok">pass — ${r.compilerGate.fileCount} file(s)</span>
                  : <span class="badge badge-fail">fail</span> }
              ${ !r.compilerGate.ok && r.compilerGate.error ? <div class="gate-error">${r.compilerGate.error}</div> : "" }
            </li>

            <!-- Gate 4: tests -->
            <li class="gate">
              <span class="gate-name">Tests</span>
              ${ r.testsGate.ok
                ? <span class="badge badge-ok">pass — ${r.testsGate.count}</span>
                : <span class="badge badge-fail">fail</span> }
              ${ !r.testsGate.ok && r.testsGate.error ? <div class="gate-error">${r.testsGate.error}</div> : "" }
            </li>

          </ul>
        </Loaded>
      </match>

    </section>
  </main>

</div>

#{
  @import url('theme.css');

  /* land.scrml — local chrome (theme.css covers app/header/nav baseline) */

  .panel {
    padding: 1.5rem;
  }

  .banner {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    margin: 1rem 0;
  }
  .banner-ok {
    background: #1a3d1f;
    color: #b3f5bc;
    border: 1px solid #2d6a36;
  }
  .banner-fail {
    background: #3d1a1a;
    color: #f5b3b3;
    border: 1px solid #6a2d2d;
  }

  .gates {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
  }
  .gate {
    padding: 0.75rem 1rem;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    margin-bottom: 0.5rem;
    background: #161616;
  }
  .gate-name {
    font-weight: 600;
    margin-right: 0.75rem;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .badge-ok {
    background: #1a3d1f;
    color: #b3f5bc;
  }
  .badge-fail {
    background: #3d1a1a;
    color: #f5b3b3;
  }
  .badge-skip {
    background: #2a2a2a;
    color: #aaa;
  }

  .gate-detail {
    margin: 0.5rem 0 0 0;
    padding-left: 1.5rem;
    color: #ccc;
    font-size: 0.9rem;
  }

  .gate-error {
    margin: 0.5rem 0 0 0;
    padding: 0.5rem;
    background: #1a1a1a;
    color: #f5b3b3;
    border-radius: 4px;
    font-size: 0.85rem;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .error {
    color: #f5b3b3;
  }
}

</program>
