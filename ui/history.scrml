// giti — history timeline
//
// Dedicated screen listing the recent save log. Parallel to status.scrml —
// same shell chrome, different data focus. Models the async load as a
// TimelinePhase enum (Loading/Loaded/Failed) rendered via <match>, so the
// .Loading initial variant replaces the old defaults-dodge (no GITI-006 hack).
//
// Engine: giti's jj-cli wrapper returns
//   { changeId, description, author, timestamp }
// per entry. No conflict handling here — that lives on the status screen.

<program>

// GITI-009 fixed upstream: scrml rewrites relative-import paths for dist/ui/.
import { getEngine } from '../src/engine/index.js'

type Entry:struct = { changeId: string, description: string, author: string, timestamp: string }
type TimelinePhase:enum = {
  Loading
  Loaded(entries: Entry[])
  Failed(err: string)
}

// Distinct from status.scrml's loadHistory — this fetches a larger window.
// Different name also avoids any per-file route-collision ambiguity in
// composeScrmlFetch. Returns a TimelinePhase variant straight off the engine
// Result tuple — no error-tuple, no defaults-dodge.
server function loadTimeline() {
  const engine = getEngine()
  const res = await engine.history(50)
  if (!res.ok) return TimelinePhase.Failed(res.error)
  return TimelinePhase.Loaded(res.data)
}

<timeline> = TimelinePhase.Loading
on mount { @timeline = loadTimeline() }

<div class="app">

  <header class="topbar">
    <div class="title">
      <span class="logo">giti</span>
      <span class="muted">history</span>
    </div>
    <nav>
      <a href="/">Status</a>
      <a href="/history.html" class="active">History</a>
      <a href="/bookmarks.html">Bookmarks</a>
      <a href="/diff.html">Diff</a>
      <a href="/land.html">Land</a>
      <a href="/live.html">Live</a>
    </nav>
  </header>

  <main>

    <section class="panel">
      <h2>Timeline</h2>
      <p class="muted">Most recent 50 saves. Run <code>giti history</code> in the terminal for the full log.</p>

      <match for=TimelinePhase on=@timeline>
        <Loading><p class="muted">Loading…</p></Loading>
        <Failed(err)><p class="error">Could not read history: ${err}</p></Failed>
        <Loaded(entries)>
          <ol class="history-list">
            <each in=entries key=@.changeId>
              <li class="entry">
                <span class="change-id">${@.changeId}</span>
                <span class="desc">${@.description || "(no message)"}</span>
                <span class="author muted">${@.author}</span>
                <span class="time muted">${@.timestamp}</span>
              </li>
              <empty><p class="muted">No saves yet. Try <code>giti save "first"</code>.</p></empty>
            </each>
          </ol>
        </Loaded>
      </match>
    </section>

  </main>

  <footer class="bottombar">
    <span class="muted">giti 0.1.0</span>
    <span class="muted">·</span>
    <span class="muted">local-dev</span>
  </footer>

</div>

#{
  @import url('theme.css');

  /* Shared chrome lives in theme.css. Only page-specific rules below. */

  .change-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--accent);
  }

  .history-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .history-list .entry {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .history-list .entry:last-child {
    border-bottom: none;
  }

  .desc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author, .time {
    font-size: 12px;
  }
}

</program>
