// server-helpers.scrml — small HTTP-server helpers ported from
// src/server/index.js. S10 slice 19 dogfood.
//
// New surface tested:
//   - Closures: a function that returns another function
//   - Returning a typed `Response` was attempted but `Response` isn't in
//     scrml's logic scope and isn't exposed via scrml:host or scrml:http
//     stdlibs — `json` stays JS-side.
//
// GITI-015 workaround applied: hoist computed-member access into a
// const before using `is some` in ternary.

${
    export const MIME = {
        ".html": "text/html; charset=utf-8",
        ".js":   "application/javascript; charset=utf-8",
        ".css":  "text/css; charset=utf-8",
        ".json": "application/json; charset=utf-8",
        ".svg":  "image/svg+xml",
        ".png":  "image/png",
        ".ico":  "image/x-icon",
    }

    // mimeFor — map a path's extension to a MIME string, with octet-stream
    // fallback.
    export function mimeFor(path) {
        const dot = path.lastIndexOf(".")
        if (dot < 0) return "application/octet-stream"
        const ext = path.slice(dot)
        const hit = MIME[ext]
        return hit is some ? hit : "application/octet-stream"
    }

    // composeScrmlFetch — chain a list of scrml-generated fetch handlers
    // into a single dispatcher. First non-null Response wins. Spec:
    // design-insight 22.
    export function composeScrmlFetch(handlers) {
        return async function scrmlDispatch(req) {
            for (const h of handlers) {
                const r = await h(req)
                if (r is some) return r
            }
            return not
        }
    }
}
