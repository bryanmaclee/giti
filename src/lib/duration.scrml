// duration.scrml — pure-logic helpers ported from JS as a scrml dogfood
// experiment (giti S10).
//
// Goal: prove out that scrml can host giti's CLI logic, not just its UI.
// Mirrors the original JS in src/commands/history.js so we can swap the
// JS callsite to import the compiled scrml output.

${
    // parseDuration — accept "30m" / "2h" / "1d" / "7d" forms.
    // Returns { ok: true, ms } or { ok: false, error }.
    export function parseDuration(s) {
        if (typeof s != "string") {
            return { ok: false, error: "duration is required" }
        }
        const m = s.match(/^(\d+)(m|h|d)$/)
        if (m is not) {
            return {
                ok: false,
                error: "invalid duration '" + s + "'. Use forms like 30m, 2h, 1d, 7d."
            }
        }
        const n = parseInt(m[1], 10)
        if (n == 0) {
            return { ok: false, error: "duration must be positive (e.g. 30m, 2h, 1d)" }
        }
        const unitMs = { m: 60000, h: 3600000, d: 86400000 }[m[2]]
        return { ok: true, ms: n * unitMs }
    }

    // parseTimestamp — accept "YYYY-MM-DD HH:MM" → epoch ms (or NaN).
    export function parseTimestamp(s) {
        if (typeof s != "string") return NaN
        const m = s.match(/^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})$/)
        if (m is not) return NaN
        return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5]).getTime()
    }
}
