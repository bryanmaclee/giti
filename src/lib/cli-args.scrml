// cli-args.scrml — small CLI argument parsers. S10 slice 9 dogfood.
//
// Ports `extractSince` (from history.js) and `parseSyncArgs` (from
// sync.js). Both are pure functions over a string[] argv tail.

${
    // parseSaveFlags — pull `--split` out, return { split, messageArgs }.
    // Everything that isn't `--split` is kept in order in messageArgs so
    // the caller can `.join(" ")` it back into a save message.
    export fn parseSaveFlags(args) {
        const out = []
        let split = false
        for (const a of args) {
            if (a == "--split") {
                split = true
                continue
            }
            out.push(a)
        }
        return { split, messageArgs: out }
    }

    // extractSince — pull `--since <duration>` out of an args array.
    // Returns { since: string | not, rest: string[] }.
    export fn extractSince(args) {
        const i = args.indexOf("--since")
        if (i == -1) return { since: not, rest: args }
        const value = args[i + 1]
        return {
            since: value,
            rest: args.slice(0, i).concat(args.slice(i + 2)),
        }
    }

    // parseSyncArgs — parse `giti sync [--remote NAME] [--push] [--pull]`.
    // If neither --push nor --pull is given, defaults to both (full sync).
    // Supports both `--remote NAME` (space form) and `--remote=NAME`.
    export function parseSyncArgs(args) {
        let remote = not
        let push = false
        let pull = false

        for (let i = 0; i < args.length; i = i + 1) {
            const a = args[i]
            if (a == "--remote") {
                remote = args[i + 1] is some ? args[i + 1] : not
                i = i + 1
            } else if (a.startsWith("--remote=")) {
                remote = a.slice("--remote=".length)
            } else if (a == "--push") {
                push = true
            } else if (a == "--pull") {
                pull = true
            }
        }

        if (!push && !pull) {
            push = true
            pull = true
        }
        return { remote, push, pull }
    }
}
