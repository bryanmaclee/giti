// resolve-compiler.scrml — find the scrml compiler CLI entry point.
// S10 slice 14 dogfood. Port of resolveCompilerPath from src/commands/land.js.
//
// New surface tested in this port:
//   - Multi-stdlib import: scrml:path + scrml:fs + scrml:process
//   - Default parameters with destructure + nested defaults
//   - Mixed injection model: opts can inject env/fs OR scrml stdlib is used
//
// Lookup order (matches JS original):
//   1. env override: SCRML_PATH (canonical), else legacy SCRMLTS_PATH
//      — from opts.env when injected, else the real process env
//   2. sibling checkout at <cwd>/../scrml  (canonical, post-rename)
//   3. sibling checkout at <cwd>/../scrmlTS (legacy, pre-rename back-compat)

${
    import { resolve, join } from "scrml:path"
    import { existsSync as fsExistsSync } from "scrml:fs"
    import { cwd as processCwd, env as processEnv } from "scrml:process"

    // resolveCompilerPath — find the scrml compiler's CLI.
    // Returns { ok: true, path, root } or { ok: false, error }.
    //
    // opts (all optional):
    //   - cwd: override the cwd for the sibling search
    //   - env: an object with SCRML_PATH / SCRMLTS_PATH (for tests)
    //   - fs: an object with an existsSync method (for tests)
    export function resolveCompilerPath(opts) {
        const o = opts is some ? opts : {}
        const myCwd = o.cwd is some ? o.cwd : processCwd()
        // Resolve an explicit compiler path from env: prefer SCRML_PATH
        // (canonical), fall back to the legacy SCRMLTS_PATH. Pull from an
        // injected env object (tests) or the real process env.
        const envScrml = o.env is some ? o.env.SCRML_PATH : processEnv("SCRML_PATH")
        const envLegacy = o.env is some ? o.env.SCRMLTS_PATH : processEnv("SCRMLTS_PATH")
        const envPath = envScrml is some ? envScrml : envLegacy
        const myExistsSync = o.fs is some ? o.fs.existsSync : fsExistsSync

        const candidates = []
        if (envPath) candidates.push(resolve(envPath))
        // Sibling checkouts: ../scrml is the canonical name; ../scrmlTS is
        // the pre-rename name, kept so older layouts still resolve.
        candidates.push(resolve(myCwd, "..", "scrml"))
        candidates.push(resolve(myCwd, "..", "scrmlTS"))

        for (const root of candidates) {
            const cli = join(root, "compiler", "src", "cli.js")
            if (myExistsSync(cli)) {
                return { ok: true, path: cli, root }
            }
        }

        return {
            ok: false,
            error:
                "Could not find the scrml compiler.\n" +
                "Set $SCRML_PATH (or legacy $SCRMLTS_PATH) to your scrml checkout, " +
                "or place scrml next to giti:\n" +
                "  scrmlMaster/\n" +
                "    giti/\n" +
                "    scrml/",
        }
    }
}
